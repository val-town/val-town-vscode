{
	"name": "valtown",
	"displayName": "Val Town",
	"description": "VS Code integration for val.town",
	"version": "0.9.1",
	"publisher": "pomdtr",
	"private": true,
	"icon": "assets/icon.png",
	"license": "MIT",
	"homepage": "https://val.town",
	"repository": {
		"type": "git",
		"url": "https://github.com/val-town/val-town-vscode"
	},
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Education",
		"Other"
	],
	"activationEvents": [
		"onFileSystem:vt+val",
		"onFileSystem:vt+blob"
	],
	"browser": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "valtown",
					"title": "Val Town",
					"icon": "resources/activity.svg"
				}
			]
		},
		"views": {
			"valtown": [
				{
					"id": "valtown.vals",
					"name": "Vals"
				},
				{
					"id": "valtown.blobs",
					"name": "Blobs"
				},
				{
					"id": "valtown.sqlite",
					"name": "SQLite"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "valtown.vals",
				"contents": "Set your Val Town token to use this extension.\n[Set Token](command:valtown.setToken)\n[API Tokens](https://www.val.town/settings/api)",
				"when": "!valtown.loggedIn"
			},
			{
				"view": "valtown.blobs",
				"contents": "Set your Val Town token to use this extension.\n[Set Token](command:valtown.setToken)\n[API Tokens](https://www.val.town/settings/api)",
				"when": "!valtown.loggedIn"
			},
			{
				"view": "valtown.sqlite",
				"contents": "Set your Val Town token to use this extension.\n[Set Token](command:valtown.setToken)\n[API Tokens](https://www.val.town/settings/api)",
				"when": "!valtown.loggedIn"
			}
		],
		"commands": [
			{
				"command": "valtown.blob.quickOpen",
				"title": "Open Blob...",
				"category": "Val Town"
			},
			{
				"command": "valtown.copyValID",
				"title": "Copy ID",
				"category": "Val Town"
			},
			{
				"command": "valtown.copyValUrl",
				"title": "Copy URL",
				"category": "Val Town",
				"icon": "$(link)"
			},
			{
				"command": "valtown.openValUrl",
				"title": "Open in Browser",
				"category": "Val Town",
				"icon": "$(globe)"
			},
			{
				"command": "valtown.setToken",
				"category": "Val Town",
				"title": "Set Token"
			},
			{
				"command": "valtown.copyToken",
				"category": "Val Town",
				"title": "Copy Token"
			},
			{
				"command": "valtown.clearToken",
				"category": "Val Town",
				"title": "Clear Token"
			},
			{
				"command": "valtown.blob.refresh",
				"category": "Val Town",
				"title": "Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "valtown.blob.delete",
				"category": "Val Town",
				"title": "Delete Blob"
			},
			{
				"command": "valtown.blob.rename",
				"category": "Val Town",
				"title": "Rename Blob"
			},
			{
				"command": "valtown.blob.create",
				"category": "Val Town",
				"title": "Create Blob",
				"icon": "$(plus)"
			},
			{
				"command": "valtown.blob.upload",
				"category": "Val Town",
				"title": "Upload Blob",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "valtown.blob.download",
				"category": "Val Town",
				"title": "Download Blob",
				"icon": "$(cloud-download)"
			},
			{
				"command": "valtown.blob.copyKey",
				"category": "Val Town",
				"title": "Copy Blob Key",
				"icon": "$(copy)"
			},
			{
				"command": "valtown.sqlite.refresh",
				"category": "Val Town",
				"title": "Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "valtown.sqlite.copyTableName",
				"category": "Val Town",
				"title": "Copy Table Name"
			},
			{
				"command": "valtown.sqlite.copyColumnName",
				"category": "Val Town",
				"title": "Copy Column Name"
			},
			{
				"command": "valtown.sqlite.newQuery",
				"category": "Val Town",
				"title": "New Query",
				"icon": "$(new-file)"
			},
			{
				"command": "valtown.sqlite.runQuery",
				"category": "Val Town",
				"title": "Run Query",
				"icon": "$(play)"
			},
			{
				"command": "valtown.sqlite.dropTable",
				"category": "Val Town",
				"title": "Drop Table"
			},
			{
				"command": "valtown.val.openReadme",
				"category": "Val Town",
				"title": "Open Val Readme",
				"icon": "$(markdown)"
			},
			{
				"command": "valtown.val.open",
				"category": "Val Town",
				"title": "Open Val",
				"icon": "$(file-code)"
			},
			{
				"command": "valtown.vals.openAsWorkspace",
				"title": "Open as Workspace",
				"when": "false"
			}
		],
		"configuration": [
			{
				"title": "Val Town",
				"type": "object",
				"properties": {
					"valtown.endpoint": {
						"type": "string",
						"description": "The Val Town API endpoint to use.",
						"default": "https://api.val.town"
					}
				}
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "valtown.setToken"
				},
				{
					"command": "valtown.clearToken",
					"when": "valtown.loggedIn"
				},
				{
					"command": "valtown.copyValID",
					"when": "false"
				},
				{
					"command": "valtown.copyValUrl",
					"when": "false"
				},
				{
					"command": "valtown.openValUrl",
					"when": "false"
				},
				{
					"command": "valtown.blob.refresh",
					"when": "false"
				},
				{
					"command": "valtown.blob.delete",
					"when": "false"
				},
				{
					"command": "valtown.blob.rename",
					"when": "false"
				},
				{
					"command": "valtown.blob.download",
					"when": "false"
				},
				{
					"command": "valtown.blob.copyKey",
					"when": "false"
				},
				{
					"command": "valtown.sqlite.refresh",
					"when": "false"
				},
				{
					"command": "valtown.sqlite.copyTableName",
					"when": "false"
				},
				{
					"command": "valtown.sqlite.copyColumnName",
					"when": "false"
				},
				{
					"command": "valtown.sqlite.dropTable",
					"when": "false"
				},
				{
					"command": "valtown.val.openReadme",
					"when": "false"
				},
				{
					"command": "valtown.val.open",
					"when": "false"
				},
				{
					"command": "valtown.vals.openAsWorkspace",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "valtown.blob.create",
					"group": "navigation@1",
					"when": "view == valtown.blobs && valtown.loggedIn"
				},
				{
					"command": "valtown.blob.upload",
					"group": "navigation@2",
					"when": "view == valtown.blobs && valtown.loggedIn"
				},
				{
					"command": "valtown.blob.refresh",
					"group": "navigation@3",
					"when": "view == valtown.blobs && valtown.loggedIn"
				},
				{
					"command": "valtown.sqlite.newQuery",
					"group": "navigation@1",
					"when": "view == valtown.sqlite && valtown.loggedIn"
				},
				{
					"command": "valtown.sqlite.refresh",
					"group": "navigation@2",
					"when": "view == valtown.sqlite && valtown.loggedIn"
				}
			],
			"view/item/context": [
				{
					"command": "valtown.openValUrl",
					"group": "navigation@1",
					"when": "viewItem == val"
				},
				{
					"command": "valtown.copyValUrl",
					"group": "navigation@2",
					"when": "viewItem == val"
				},
				{
					"command": "valtown.copyValID",
					"group": "navigation@3",
					"when": "viewItem == val"
				},
				{
					"command": "valtown.vals.openAsWorkspace",
					"group": "navigation@4",
					"when": "viewItem == val"
				},
				{
					"command": "valtown.blob.copyKey",
					"group": "navigation@1",
					"when": "viewItem == blob"
				},
				{
					"command": "valtown.blob.download",
					"group": "navigation@2",
					"when": "viewItem == blob"
				},
				{
					"command": "valtown.blob.rename",
					"group": "navigation@3",
					"when": "viewItem == blob"
				},
				{
					"command": "valtown.blob.delete",
					"group": "navigation@4",
					"when": "viewItem == blob"
				},
				{
					"command": "valtown.sqlite.dropTable",
					"group": "navigation@2",
					"when": "view == valtown.sqlite && viewItem == table"
				},
				{
					"command": "valtown.sqlite.copyTableName",
					"group": "navigation@2",
					"when": "view == valtown.sqlite && viewItem == table"
				},
				{
					"command": "valtown.sqlite.copyColumnName",
					"group": "navigation@2",
					"when": "view == valtown.sqlite && viewItem == column"
				}
			],
			"valtown.submenus.open": [],
			"valtown.submenus.copy": []
		},
		"submenus": [
			{
				"id": "valtown.submenus.open",
				"label": "Open"
			},
			{
				"id": "valtown.submenus.privacy",
				"label": "Set Privacy"
			},
			{
				"id": "valtown.submenus.copy",
				"label": "Copy"
			},
			{
				"id": "valtown.privacy",
				"label": "Set Privacy"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"lint": "eslint src --ext=ts"
	},
	"devDependencies": {
		"@types/node": "^16.18.34",
		"@types/vscode": "^1.73.0",
		"@typescript-eslint/eslint-plugin": "^6.7.0",
		"@typescript-eslint/parser": "^6.7.0",
		"eslint": "^8.26.0",
		"ts-loader": "^9.5.0",
		"typescript": "^5.2.2",
		"webpack": "^5.89.0",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"@valtown/sdk": "^1.9.0"
	}
}
